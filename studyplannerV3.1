        function markTaskComplete() {
            const progressData = getProgressData();
            progressData.completedTasks = (progressData.completedTasks || 0) + 1;
            
            // Update streak
            const today = new Date().toISOString().split('T')[0];
            if (progressData.lastStudyDate) {
                const lastDate = new Date(progressData.lastStudyDate);
                const currentDate = new Date(today);
                const diffTime = Math.abs(currentDate - lastDate);
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                
                if (diffDays === 1) {
                    progressData.streak = (progressData.streak || 0) + 1;
                } else if (diffDays > 1) {
                    progressData.streak = 1;
                }
            }
            
            progressData.lastStudyDate = today;
            progressData.studiedDates = progressData.studiedDates || {};
            progressData.studiedDates[today] = true;
            
            saveProgressData(progressData);
            updateProgressStats();
            alert('Task marked as complete! Streak updated.');
        }

        function markStudyDay(date) {
            const progressData = getProgressData();
            progressData.studiedDates = progressData.studiedDates || {};
            progressData.studiedDates[date] = true;
            saveProgressData(progressData);
            updateCalendar();
        }

