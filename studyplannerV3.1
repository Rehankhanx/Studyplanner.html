        function updateProgressStats() {
            const progressData = getProgressData();
            
            document.getElementById('streakDays').textContent = progressData.streak || 0;
            document.getElementById('completedTasks').textContent = progressData.completedTasks || 0;
            
            // Calculate skills learned
            const skillsLearned = Object.keys(progressData.skills || {}).length;
            document.getElementById('skillsLearned').textContent = skillsLearned;
            
            // Calculate job readiness score (simplified)
            const totalCriticalSkills = 15; // Approximate count
            const readinessScore = Math.min(100, Math.floor((skillsLearned / totalCriticalSkills) * 100));
            document.getElementById('readinessScore').textContent = `${readinessScore}%`;
            
            // Update overall progress bar
            const overallProgress = document.getElementById('overallProgress');
            overallProgress.style.width = `${readinessScore}%`;
        }

        function updateCalendar() {
            const calendar = document.getElementById('studyCalendar');
            const progressData = getProgressData();
            const studiedDates = progressData.studiedDates || {};
            
            // Get current month
            const today = new Date();
            const currentMonth = today.getMonth();
            const currentYear = today.getFullYear();
            
            // Generate calendar days
            let calendarHTML = '';
            
            // Month header
            const monthNames = ['January', 'February', 'March', 'April', 'May', 'June',
                               'July', 'August', 'September', 'October', 'November', 'December'];
            
            // Get days in month
            const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
            
            for (let day = 1; day <= daysInMonth; day++) {
                const dateStr = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                const isStudied = studiedDates[dateStr];
                const isToday = dateStr === today.toISOString().split('T')[0];
                
                calendarHTML += `
                    <div class="calendar-day ${isStudied ? 'studied' : ''} ${isToday ? 'current' : ''}">
                        ${day}
                        ${isStudied ? '<br><small>✓</small>' : ''}
                    </div>
                `;
            }
            
            calendar.innerHTML = calendarHTML;
        }

        function exportProgress() {
            const progressData = getProgressData();
            const dataStr = JSON.stringify(progressData, null, 2);
            const dataUri = 'data:application/json;charset=utf-8,'+ encodeURIComponent(dataStr);
            
            const exportFileDefaultName = `ai-teacher-progress-${new Date().toISOString().split('T')[0]}.json`;
            
            const linkElement = document.createElement('a');
            linkElement.setAttribute('href', dataUri);
            linkElement.setAttribute('download', exportFileDefaultName);
            linkElement.click();
        }

