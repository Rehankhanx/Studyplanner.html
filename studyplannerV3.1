        // ====================================
        // LOCAL STORAGE BACKUP & RECOVERY
        // ====================================

        function backupData() {
            const data = localStorage.getItem('aiTeacherProgress');
            const blob = new Blob([data], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            
            const a = document.createElement('a');
            a.href = url;
            a.download = `ai-teacher-backup-${new Date().toISOString().split('T')[0]}.json`;
            a.click();
            
            URL.revokeObjectURL(url);
        }

        function restoreData(file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const data = JSON.parse(e.target.result);
                localStorage.setItem('aiTeacherProgress', JSON.stringify(data));
                alert('Data restored successfully! Please refresh the page.');
                location.reload();
            };
            reader.readAsText(file);
        }

        // Auto-backup every week
        setInterval(backupData, 7 * 24 * 60 * 60 * 1000);

