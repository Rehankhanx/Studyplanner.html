        function addToPortfolio(projectTitle) {
            const progressData = getProgressData();
            progressData.projects = progressData.projects || [];
            
            if (!progressData.projects.includes(projectTitle)) {
                progressData.projects.push(projectTitle);
                saveProgressData(progressData);
                alert(`${projectTitle} added to your portfolio!`);
            } else {
                alert('Project already in portfolio.');
