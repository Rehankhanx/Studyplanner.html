                        ${plan.subjects.map(subject => `
                            <div class="timetable-subject">
                                <div style="font-weight: 600; color: ${subjects[subject.name].color};">
                                    <i class="${subject.icon}"></i> ${subject.name}
                                </div>
                                <div style="font-size: 0.9rem; margin: 0.5rem 0;">${subject.topic.name}</div>
                                <div style="font-size: 0.85rem; color: var(--text-light);">
                                    <i class="fas fa-clock"></i> ${subject.time}
                                </div>
                            </div>
                        `).join('')}
                    `;
                }
                
                tableHTML += `</td>`;
            }
            
            tableHTML += `</tr></tbody>`;
            table.innerHTML = tableHTML;
        }

        function renderRoadmap() {
            const container = document.getElementById('roadmapLadder');
            if (!container) return;
            
            container.innerHTML = roadmapData.map(semester => `
                <div class="roadmap-item ${semester.status} ${semester.semester === appState.currentSemester ? 'current' : ''}">
                    <div class="semester-badge">Semester ${semester.semester}</div>
                    <div class="roadmap-content">
                        <div class="semester-title">
                            <i class="fas fa-graduation-cap"></i>
                            Semester ${semester.semester} - ${semester.status.replace('-', ' ').toUpperCase()}
                        </div>
                        
                        <div class="semester-subjects">
                            ${semester.subjects.map(subject => `
                                <span class="subject-tag">${subject}</span>
                            `).join('')}
                        </div>
                        
                        <div class="skills-grid">
                            ${semester.skills.map(skill => `
                                <div class="skill-item">
                                    <i class="fas fa-check-circle"></i> ${skill}
                                </div>
                            `).join('')}
                        </div>
                        
                        <div class="projects-list">
                            <h4 style="margin-bottom: 0.5rem; color: var(--text-dark);">
                                <i class="fas fa-project-diagram"></i> Recommended Projects:
                            </h4>
                            ${semester.projects.map(project => `
                                <div class="project-item">
                                    <i class="fas fa-code-branch"></i>
                                    ${project}
                                </div>
                            `).join('')}
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function renderProgress() {
            // Calculate statistics
            const totalStudyDays = appState.dailyPlans.filter(plan => !plan.isHoliday).length;
            const completedStudyDays = Object.values(appState.completedDays).filter(Boolean).length;
            const completionRate = totalStudyDays > 0 ? Math.round((completedStudyDays / totalStudyDays) * 100) : 0;
            
            // Calculate completed topics
            const completedTopics = Object.values(appState.completedTopics).flat().length;
            const totalTopics = 260; // Approximate total topics
            
            // Update UI
            document.getElementById('totalDays').textContent = totalStudyDays;
            document.getElementById('currentStreak').textContent = appState.currentStreak;
            document.getElementById('bestStreak').textContent = appState.bestStreak;
            document.getElementById('completionRate').textContent = `${completionRate}%`;
            document.getElementById('completedTopics').textContent = completedTopics;
            document.getElementById('studyHours').textContent = completedTopics * 1.5; // Approximate hours
            document.getElementById('daysRemaining').textContent = totalStudyDays - completedStudyDays;
            
            // Calculate next subject
            const today = new Date();
            const tomorrow = new Date(today);
            tomorrow.setDate(tomorrow.getDate() + 1);
            const tomorrowPlan = generateDailyPlan(tomorrow);
            document.getElementById('nextSubject').textContent = 
                tomorrowPlan.subjects.length > 0 ? tomorrowPlan.subjects[0].name.split(' ')[0] : 'Holiday';
            
            // Render subject progress bars
            const subjectProgress = document.getElementById('subjectProgress');
            if (subjectProgress) {
                subjectProgress.innerHTML = Object.keys(subjects).map(subject => {
                    const subjectTopics = subjects[subject].topics.length;
                    const completedSubjectTopics = Object.values(appState.completedTopics)
                        .filter(topic => topic.includes(subject)).length;
                    const progressPercent = (completedSubjectTopics / subjectTopics) * 100;
                    
                    return `
                        <div style="margin-bottom: 1rem;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                                <span style="font-weight: 500;">${subject}</span>
                                <span>${completedSubjectTopics}/${subjectTopics} topics</span>
                            </div>
                            <div style="height: 8px; background: var(--border-color); border-radius: 4px; overflow: hidden;">
                                <div style="width: ${progressPercent}%; height: 100%; background: ${subjects[subject].color}; border-radius: 4px;"></div>
                            </div>
                        </div>
                    `;
                }).join('');
            }
        }

        // ============================================
        // EVENT HANDLERS AND STATE MANAGEMENT
        // ============================================

        function toggleDayCompletion(dateString, completed) {
            appState.completedDays[dateString] = completed;
            
            // Update streak
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const yesterday = new Date(today);
            yesterday.setDate(yesterday.getDate() - 1);
            
            const todayStr = formatDateForInput(today);
            const yesterdayStr = formatDateForInput(yesterday);
            
            if (completed) {
                if (appState.lastStudyDate === yesterdayStr) {
                    appState.currentStreak += 1;
                } else if (appState.lastStudyDate !== todayStr) {
                    appState.currentStreak = 1;
                }
                
                appState.lastStudyDate = todayStr;
                
                if (appState.currentStreak > appState.bestStreak) {
                    appState.bestStreak = appState.currentStreak;
                }
            } else if (dateString === todayStr) {
                appState.currentStreak = Math.max(0, appState.currentStreak - 1);
            }
            
            saveState();
            updateStats();
            renderDailyPlans();
        }

        function markTopicComplete(dateString, subject, topicName) {
            if (!appState.completedTopics[dateString]) {
                appState.completedTopics[dateString] = [];
            }
            
            const topicKey = `${subject}:${topicName}`;
            if (!appState.completedTopics[dateString].includes(topicKey)) {
                appState.completedTopics[dateString].push(topicKey);
                saveState();
                updateStats();
                
                // Show success message
                showNotification(`Topic marked as complete: ${topicName}`);
            }
        }

        function saveDayNotes(dateString, notes) {
            appState.dayNotes[dateString] = notes;
            saveState();
        }

        function saveState() {
            localStorage.setItem('completedDays', JSON.stringify(appState.completedDays));
            localStorage.setItem('dayNotes', JSON.stringify(appState.dayNotes));
            localStorage.setItem('completedTopics', JSON.stringify(appState.completedTopics));
            localStorage.setItem('currentStreak', appState.currentStreak.toString());
            localStorage.setItem('bestStreak', appState.bestStreak.toString());
            localStorage.setItem('lastStudyDate', appState.lastStudyDate);
        }

        function updateStats() {
            renderProgress();
        }

        // ============================================
        // PRINT FUNCTIONS
        // ============================================

        function printSection(sectionId) {
            const originalDisplay = document.getElementById(sectionId).style.display;
            document.getElementById(sectionId).style.display = 'block';
            
            // Hide other sections temporarily
            document.querySelectorAll('.content-section').forEach(section => {
                if (section.id !== sectionId) {
                    section.style.display = 'none';
                }
            });
            
            window.print();
            
            // Restore original state
            document.getElementById(sectionId).style.display = originalDisplay;
            document.querySelectorAll('.content-section').forEach(section => {
                section.style.display = section.id === 'daily' ? 'block' : 'none';
            });
        }

        function printSinglePlan(dateString) {
            const plan = appState.dailyPlans.find(p => formatDateForInput(p.date) === dateString);
            if (!plan) return;
            
            const printWindow = window.open('', '_blank');
            printWindow.document.write(`
                <html>
                    <head>
                        <title>Study Plan - ${plan.formattedDate}</title>
                        <style>
                            body { font-family: Arial, sans-serif; padding: 20px; }
                            .plan-header { background: #2563eb; color: white; padding: 20px; border-radius: 8px; }
                            .subject-card { border-left: 4px solid; padding: 15px; margin: 15px 0; background: #f8fafc; }
                            .topic-guide { background: white; padding: 15px; border-radius: 8px; margin-top: 10px; }
                        </style>
                    </head>
                    <body>
                        <div class="plan-header">
                            <h1>${plan.formattedDate}</h1>
                            <p>${plan.dayName} ${plan.isHoliday ? '• Holiday' : ''}</p>
                        </div>
                        
                        ${plan.isHoliday ? `
                            <div style="text-align: center; padding: 40px;">
                                <h2>Enjoy Your Holiday!</h2>
                                <p>Take a break and recharge for the week ahead.</p>
                            </div>
                        ` : `
                            ${plan.subjects.map(subject => `
                                <div class="subject-card" style="border-left-color: ${subjects[subject.name].color}">
                                    <h3>${subject.name}</h3>
                                    <p><strong>Time:</strong> ${subject.time}</p>
                                    <div class="topic-guide">
                                        <h4>${subject.topic.name}</h4>
                                        <p>${subject.topic.guide}</p>
                                        <p><em>Estimated study time: ${subject.topic.time}</em></p>
                                    </div>
                                </div>
                            `).join('')}
                            
                            ${appState.dayNotes[dateString] ? `
                                <div style="margin-top: 30px;">
                                    <h3>Notes:</h3>
                                    <p>${appState.dayNotes[dateString]}</p>
                                </div>
                            ` : ''}
                        `}
                    </body>
                </html>
            `);
            printWindow.document.close();
            printWindow.print();
        }

        function generateWeeklyTimetable() {
            const startDateInput = document.getElementById('weekStart');
            renderWeeklyTimetable(startDateInput.value);
        }

        function showNotification(message) {
            // Create notification element
            const notification = document.createElement('div');
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: var(--primary-blue);
                color: white;
                padding: 1rem 1.5rem;
                border-radius: var(--radius);
                box-shadow: var(--shadow-lg);
                z-index: 1000;
                animation: slideIn 0.3s ease;
            `;
            
            notification.innerHTML = `
                <i class="fas fa-check-circle" style="margin-right: 10px;"></i>
                ${message}
            `;
            
            document.body.appendChild(notification);
            
            // Remove after 3 seconds
            setTimeout(() => {
                notification.style.animation = 'slideOut 0.3s ease';
                setTimeout(() => notification.remove(), 300);
            }, 3000);
        }

        function resetProgress() {
            if (confirm('Are you sure you want to reset all progress? This cannot be undone.')) {
                localStorage.clear();
                location.reload();
            }
        }

        function exportData() {
            const data = {
                completedDays: appState.completedDays,
                completedTopics: appState.completedTopics,
                dayNotes: appState.dayNotes,
                stats: {
                    currentStreak: appState.currentStreak,
                    bestStreak: appState.bestStreak,
                    completionRate: document.getElementById('completionRate').textContent
                }
            };
            
            const dataStr = JSON.stringify(data, null, 2);
            const dataUri = 'data:application/json;charset=utf-8,'+ encodeURIComponent(dataStr);
            
            const exportFileDefaultName = 'study-planner-data.json';
            
            const linkElement = document.createElement('a');
            linkElement.setAttribute('href', dataUri);
            linkElement.setAttribute('download', exportFileDefaultName);
            linkElement.click();
        }

        // ============================================
        // INITIALIZATION
        // ============================================

        function init() {
            // Initialize daily plans
            appState.dailyPlans = generateAllPlans();
            
            // Set up tab navigation
            document.querySelectorAll('.nav-tab').forEach(tab => {
                tab.addEventListener('click', () => {
                    // Remove active class from all tabs
                    document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
                    document.querySelectorAll('.content-section').forEach(s => s.classList.remove('active'));
                    
                    // Add active class to clicked tab and corresponding section
                    tab.classList.add('active');
                    const tabId = tab.getAttribute('data-tab');
                    document.getElementById(tabId).classList.add('active');
                });
            });
            
            // Set up view filters
            document.querySelectorAll('.view-filter').forEach(filter => {
                filter.addEventListener('click', () => {
                    document.querySelectorAll('.view-filter').forEach(f => f.classList.remove('active'));
                    filter.classList.add('active');
                    appState.viewFilter = filter.getAttribute('data-view');
                    renderDailyPlans();
                });
            });
            
            // Set up search
            document.getElementById('searchInput')?.addEventListener('input', renderDailyPlans);
            document.getElementById('subjectFilter')?.addEventListener('change', renderDailyPlans);
            
            // Set up theme toggle
            const themeToggle = document.getElementById('themeToggle');
            const savedTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
            themeToggle.checked = savedTheme === 'dark';
            
            themeToggle.addEventListener('change', () => {
                const theme = themeToggle.checked ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', theme);
                localStorage.setItem('theme', theme);
            });
            
            // Set current date as default for weekly timetable
            const today = new Date();
            document.getElementById('weekStart').value = formatDateForInput(today);
            
            // Initial renders
            renderDailyPlans();
            renderWeeklyTimetable(today);
            renderRoadmap();
            renderProgress();
            
            // Add CSS for animations
            const style = document.createElement('style');
            style.textContent = `
                @keyframes slideIn {
                    from { transform: translateX(100%); opacity: 0; }
                    to { transform: translateX(0); opacity: 1; }
                }
                @keyframes slideOut {
                    from { transform: translateX(0); opacity: 1; }
                    to { transform: translateX(100%); opacity: 0; }
                }
            `;
            document.head.appendChild(style);
        }

        // Initialize the app when DOM is loaded
        document.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>
