        function renderDailyPlans() {
            const container = document.getElementById('dailyPlansContainer');
            if (!container) return;
            
            let filteredPlans = [...appState.dailyPlans];
            
            // Apply filters
            if (appState.viewFilter === 'upcoming') {
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                filteredPlans = filteredPlans.filter(plan => 
                    plan.date >= today && !plan.isHoliday
                );
            } else if (appState.viewFilter === 'completed') {
                filteredPlans = filteredPlans.filter(plan => 
                    appState.completedDays[formatDateForInput(plan.date)]
                );
            } else if (appState.viewFilter === 'holidays') {
                filteredPlans = filteredPlans.filter(plan => plan.isHoliday);
            }
            
            // Apply search filter
            const searchInput = document.getElementById('searchInput');
            const subjectFilter = document.getElementById('subjectFilter');
            
            if (searchInput && searchInput.value) {
                const searchTerm = searchInput.value.toLowerCase();
                filteredPlans = filteredPlans.filter(plan => 
                    plan.formattedDate.toLowerCase().includes(searchTerm) ||
                    plan.subjects.some(subject => 
                        subject.name.toLowerCase().includes(searchTerm) ||
                        subject.topic.name.toLowerCase().includes(searchTerm)
                    )
                );
            }
            
            if (subjectFilter && subjectFilter.value) {
                filteredPlans = filteredPlans.filter(plan =>
                    plan.subjects.some(subject => 
                        subject.name.includes(subjectFilter.value)
                    )
                );
            }
            
