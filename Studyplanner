        // Date utilities
        function formatDate(date) {
            return date.toLocaleDateString('en-US', {
                day: 'numeric',
                month: 'long',
                weekday: 'long'
            });
        }

        function formatDateForInput(date) {
            return date.toISOString().split('T')[0];
        }

        function getDayName(date) {
            return date.toLocaleDateString('en-US', { weekday: 'long' });
        }

        function generateDailyPlan(date) {
            const dayName = getDayName(date);
            const isSunday = dayName === 'Sunday';
            
            if (isSunday) {
                return {
                    date: new Date(date),
                    formattedDate: formatDate(date),
                    dayName: dayName,
                    isHoliday: true,
                    subjects: []
                };
            }
            
            // Get two subjects for the day (ensuring variety)
            const subjectList = Object.keys(subjects);
            const dayIndex = Math.floor((date - new Date('2025-01-10')) / (1000 * 60 * 60 * 24));
            const subjectIndex1 = dayIndex % subjectList.length;
            const subjectIndex2 = (dayIndex + 2) % subjectList.length;
            
            const selectedSubjects = [
                subjectList[subjectIndex1],
                subjectList[subjectIndex2]
            ];
            
            // Generate plan with topics
            const planSubjects = selectedSubjects.map((subject, index) => {
                const subjectData = subjects[subject];
                const topicIndex = Math.floor(dayIndex / 7) % subjectData.topics.length;
                
                return {
                    name: subject,
                    colorClass: subject.toLowerCase().replace(/\s+/g, '-'),
                    time: timeSlots[index % timeSlots.length],
                    topic: subjectData.topics[topicIndex],
                    icon: subjectData.icon
                };
            });
            
            return {
                date: new Date(date),
                formattedDate: formatDate(date),
                dayName: dayName,
                isHoliday: false,
                subjects: planSubjects
            };
        }

        function generateAllPlans() {
            const plans = [];
            const currentDate = new Date('2025-01-10');
            const endDate = new Date('2025-03-10');
            
            while (currentDate <= endDate) {
                plans.push(generateDailyPlan(new Date(currentDate)));
                currentDate.setDate(currentDate.getDate() + 1);
            }
            
            return plans;
        }

