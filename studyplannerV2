function toggleDayCompletion(dateString, completed) {
appState.completedDays[dateString] = completed;

if (completed) {
appState.totalStudyHours += 3; // Approximate 3 hours per study day
showToast('Day marked as completed!', 'success');
} else {
appState.totalStudyHours = Math.max(0, appState.totalStudyHours - 3);
showToast('Day marked as incomplete', 'warning');
}

saveState();
renderDashboard();
renderDailyPlans();
}

function toggleTopicCompletion(dateString, subject, topicName) {
const topicKey = `${dateString}-${subject}-${topicName}`;

if (!appState.completedTopics[dateString]) {
appState.completedTopics[dateString] = [];
}

const index = appState.completedTopics[dateString].indexOf(topicKey);

if (index === -1) {
appState.completedTopics[dateString].push(topicKey);
showToast(`Topic completed: ${topicName}`, 'success');
} else {
appState.completedTopics[dateString].splice(index, 1);
showToast(`Topic marked as incomplete`, 'warning');
}

saveState();
renderDashboard();
renderDailyPlans();
}

function saveDayNotes(dateString, notes) {
appState.dayNotes[dateString] = notes;
saveState();
showToast('Notes saved successfully!', 'success');
}

