const achievement = document.getElementById('achievement').value || 'Achievement';
const authority = document.getElementById('issuingAuthority').value || 'Issuing Authority';
const date = document.getElementById('certificateDate').value;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
year: 'numeric',
month: 'long',
day: 'numeric'
});

// Update preview
document.getElementById('previewName').textContent = studentName;
document.getElementById('previewStudentName').textContent = studentName;
document.getElementById('previewFatherName').textContent = fatherName;
document.getElementById('previewCnic').textContent = cnic;
document.getElementById('previewDepartment').textContent = department;
document.getElementById('previewAchievement').textContent = achievement;
document.getElementById('previewAuthority').textContent = authority;
document.getElementById('previewDate').textContent = formattedDate;

// Scroll to preview
document.getElementById('certificatePreview').scrollIntoView({ behavior: 'smooth' });
showToast('Certificate preview updated!', 'success');
}

function generateCertificate() {
previewCertificate();
showToast('Certificate generated successfully!', 'success');

// Save certificate to history
const certificateData = {
id: Date.now(),
studentName: document.getElementById('studentName').value,
fatherName: document.getElementById('fatherName').value,
cnic: document.getElementById('cnic').value,
department: document.getElementById('department').value,
type: document.getElementById('certificateType').value,
authority: document.getElementById('issuingAuthority').value,
achievement: document.getElementById('achievement').value,
date: document.getElementById('certificateDate').value,
generatedAt: new Date().toISOString()
};

appState.certificates.unshift(certificateData);
if (appState.certificates.length > 10) {
appState.certificates.pop();
}

saveState();
}

function printCertificate() {
printSection('certificates');
}

function downloadCertificate() {
// For now, use print functionality as PDF generation
printCertificate();
showToast('Use Print dialog and choose "Save as PDF" option', 'info');
}

// ============================================
// MODAL FUNCTIONS
// ============================================

function showPrintModal() {
document.getElementById('printModal').classList.add('active');
}

function closePrintModal() {
document.getElementById('printModal').classList.remove('active');
}

// ============================================
// EXPORT FUNCTIONS
// ============================================

function exportDailyPlans() {
const data = {
plans: appState.dailyPlans,
completedDays: appState.completedDays,
dayNotes: appState.dayNotes,
completedTopics: appState.completedTopics,
stats: calculateStats()
};

const dataStr = JSON.stringify(data, null, 2);
const dataUri = 'data:application/json;charset=utf-8,'+ encodeURIComponent(dataStr);

const linkElement = document.createElement('a');
linkElement.setAttribute('href', dataUri);
linkElement.setAttribute('download', 'bsds-study-plans.json');
linkElement.click();

showToast('Daily plans exported successfully!', 'success');
}

function exportAllData() {
const data = {
appState: appState,
stats: calculateStats(),
exportedAt: new Date().toISOString()
};

const dataStr = JSON.stringify(data, null, 2);
const dataUri = 'data:application/json;charset=utf-8,'+ encodeURIComponent(dataStr);

const linkElement = document.createElement('a');
linkElement.setAttribute('href', dataUri);
linkElement.setAttribute('download', 'bsds-complete-data.json');
linkElement.click();

showToast('All data exported successfully!', 'success');
}

function resetProgress() {
if (confirm('Are you sure you want to reset all progress? This cannot be undone.')) {
localStorage.clear();
location.reload();
}
}

// ============================================
// INITIALIZATION
// ============================================

function init() {
// Initialize daily plans
appState.dailyPlans = generateAllPlans();

// Set up navigation
document.querySelectorAll('.nav-link').forEach(link => {
link.addEventListener('click', (e) => {
e.preventDefault();

// Update active nav link
document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
link.classList.add('active');

// Show corresponding section
const sectionId = link.getAttribute('data-section');
document.querySelectorAll('.content-section').forEach(s => s.classList.remove('active'));
document.getElementById(sectionId).classList.add('active');

// Close mobile menu if open
document.getElementById('navLinks').classList.remove('active');

// Scroll to top
window.scrollTo({ top: 0, behavior: 'smooth' });
});
});

// Set up mobile menu
document.getElementById('mobileMenuBtn').addEventListener('click', () => {
document.getElementById('navLinks').classList.toggle('active');
});

// Set up theme toggle
document.querySelectorAll('.theme-btn').forEach(btn => {
btn.addEventListener('click', () => {
const theme = btn.getAttribute('data-theme');

// Update active button
document.querySelectorAll('.theme-btn').forEach(b => b.classList.remove('active'));
btn.classList.add('active');

// Set theme
document.documentElement.setAttribute('data-theme', theme);
localStorage.setItem('theme', theme);
});
});

// Set default theme
const savedTheme = localStorage.getItem('theme') || 'dark';
document.documentElement.setAttribute('data-theme', savedTheme);
document.querySelector(`.theme-btn[data-theme="${savedTheme}"]`).classList.add('active');

// Set up view filters
document.querySelectorAll('.view-filter').forEach(filter => {
filter.addEventListener('click', () => {
document.querySelectorAll('.view-filter').forEach(f => f.classList.remove('active'));
filter.classList.add('active');
appState.viewFilter = filter.getAttribute('data-view');
renderDailyPlans();
});
});

// Set up search
document.getElementById('searchInput')?.addEventListener('input', renderDailyPlans);
document.getElementById('subjectFilter')?.addEventListener('change', renderDailyPlans);

// Set up week date picker
document.getElementById('weekStart').addEventListener('change', function() {
renderWeeklyTimetable(this.value);
});

// Set print options button
document.getElementById('printOptionsBtn').addEventListener('click', (e) => {
e.preventDefault();
showPrintModal();
});

// Close modal on outside click
document.getElementById('printModal').addEventListener('click', (e) => {
if (e.target === document.getElementById('printModal')) {
closePrintModal();
}
});

// Close modal on escape key
document.addEventListener('keydown', (e) => {
if (e.key === 'Escape') {
closePrintModal();
}
});

// Initial renders
renderDashboard();
renderDailyPlans();
renderWeeklyTimetable();
renderRoadmap();
previewCertificate();

// Auto-generate certificate based on progress
const stats = calculateStats();
if (stats.completionRate >= 50 && stats.completionRate < 100) {
document.getElementById('achievement').value = `Successfully completed ${stats.completionRate}% of the 60-day study program`;
} else if (stats.completionRate === 100) {
document.getElementById('achievement').value = 'Successfully completed the entire 60-day intensive study program with distinction';
document.getElementById('certificateType').value = 'excellence';
}

// Show welcome message
setTimeout(() => {
showToast('Welcome to BS Data Science Study Planner!', 'success');
}, 1000);
}

// Initialize when DOM is loaded
document.addEventListener('DOMContentLoaded', init);
</script>
</body>
</html>
