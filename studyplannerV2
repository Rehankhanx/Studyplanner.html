
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Smart Study Planner – BS Data Science (BSDS)</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root {
--primary-gold: #D4AF37;
--dark-gold: #B8860B;
--light-gold: #F5E8C7;
--dark-bg: #1a1a2e;
--darker-bg: #16213e;
--card-bg: #222831;
--text-light: #eeeeee;
--text-gray: #b0b0b0;
--success: #10b981;
--warning: #f59e0b;
--info: #3b82f6;
--border-radius: 10px;
--shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
--shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.4);
--transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

[data-theme="light"] {
--primary-gold: #D4AF37;
--dark-gold: #B8860B;
--light-gold: #FFF9E6;
--dark-bg: #f8f9fa;
--darker-bg: #e9ecef;
--card-bg: #ffffff;
--text-light: #212529;
--text-gray: #6c757d;
--success: #28a745;
--warning: #ffc107;
--info: #17a2b8;
}

* {
margin: 0;
padding: 0;
box-sizing: border-box;
}

body {
font-family: 'Inter', sans-serif;
background-color: var(--dark-bg);
color: var(--text-light);
line-height: 1.6;
transition: var(--transition);
padding-top: 80px;
background-image:
radial-gradient(circle at 10% 20%, rgba(212, 175, 55, 0.05) 0%, transparent 20%),
radial-gradient(circle at 90% 80%, rgba(20, 30, 48, 0.05) 0%, transparent 20%);
}

.container {
max-width: 1400px;
margin: 0 auto;
padding: 0 20px;
}

/* Professional Navigation */
.navbar {
position: fixed;
top: 0;
left: 0;
right: 0;
background: linear-gradient(135deg, var(--darker-bg), var(--dark-bg));
backdrop-filter: blur(10px);
border-bottom: 2px solid var(--primary-gold);
z-index: 1000;
box-shadow: var(--shadow);
}

.nav-container {
max-width: 1400px;
margin: 0 auto;
padding: 0 20px;
display: flex;
justify-content: space-between;
align-items: center;
height: 80px;
}

.logo {
display: flex;
align-items: center;
gap: 12px;
}

.logo-icon {
background: var(--primary-gold);
color: var(--dark-bg);
width: 45px;
height: 45px;
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
font-size: 1.5rem;
font-weight: bold;
box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
}

.logo-text {
font-family: 'Poppins', sans-serif;
}

.logo-text h1 {
font-size: 1.5rem;
font-weight: 700;
background: linear-gradient(45deg, var(--primary-gold), var(--light-gold));
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
background-clip: text;
}

.logo-text span {
font-size: 0.8rem;
color: var(--text-gray);
}

.nav-links {
display: flex;
gap: 2px;
flex-wrap: wrap;
}

.nav-link {
padding: 0.8rem 1.2rem;
color: var(--text-light);
text-decoration: none;
font-weight: 500;
border-radius: var(--border-radius);
transition: var(--transition);
display: flex;
align-items: center;
gap: 8px;
position: relative;
}

.nav-link:hover, .nav-link.active {
background: rgba(212, 175, 55, 0.1);
color: var(--primary-gold);
}

.nav-link.active::after {
content: '';
position: absolute;
bottom: -2px;
left: 1.2rem;
right: 1.2rem;
height: 2px;
background: var(--primary-gold);
border-radius: 2px;
}

.nav-actions {
display: flex;
align-items: center;
gap: 15px;
}

.theme-toggle {
background: rgba(255, 255, 255, 0.1);
border: 1px solid rgba(212, 175, 55, 0.3);
border-radius: 20px;
padding: 5px;
display: flex;
cursor: pointer;
}

.theme-btn {
padding: 0.5rem 1rem;
border-radius: 15px;
border: none;
background: transparent;
color: var(--text-light);
cursor: pointer;
transition: var(--transition);
font-weight: 500;
}

.theme-btn.active {
background: var(--primary-gold);
color: var(--dark-bg);
}

.print-btn {
background: var(--primary-gold);
color: var(--dark-bg);
border: none;
padding: 0.8rem 1.5rem;
border-radius: var(--border-radius);
font-weight: 600;
cursor: pointer;
transition: var(--transition);
display: flex;
align-items: center;
gap: 8px;
}

.print-btn:hover {
background: var(--dark-gold);
transform: translateY(-2px);
box-shadow: var(--shadow);
}

.mobile-menu-btn {
display: none;
background: transparent;
border: none;
color: var(--text-light);
font-size: 1.5rem;
cursor: pointer;
}

/* Dashboard Stats */
.dashboard-stats {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
gap: 1.5rem;
margin-bottom: 2rem;
}

.stat-card {
background: var(--card-bg);
border-radius: var(--border-radius);
padding: 1.5rem;
box-shadow: var(--shadow);
border-left: 4px solid var(--primary-gold);
transition: var(--transition);
position: relative;
overflow: hidden;
}

.stat-card::before {
content: '';
position: absolute;
top: 0;
left: 0;
right: 0;
height: 3px;
background: linear-gradient(90deg, var(--primary-gold), transparent);
}

.stat-card:hover {
transform: translateY(-5px);
box-shadow: var(--shadow-lg);
}

.stat-icon {
width: 50px;
height: 50px;
background: rgba(212, 175, 55, 0.1);
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
margin-bottom: 1rem;
color: var(--primary-gold);
font-size: 1.5rem;
}

.stat-content h3 {
font-size: 0.9rem;
color: var(--text-gray);
margin-bottom: 0.5rem;
text-transform: uppercase;
letter-spacing: 1px;
}

.stat-value {
font-size: 2.2rem;
font-weight: 700;
margin-bottom: 0.5rem;
background: linear-gradient(45deg, var(--primary-gold), var(--light-gold));
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
background-clip: text;
}

.stat-progress {
height: 6px;
background: rgba(255, 255, 255, 0.1);
border-radius: 3px;
overflow: hidden;
margin-top: 1rem;
}

.stat-progress-bar {
height: 100%;
background: var(--primary-gold);
border-radius: 3px;
transition: width 1s ease;
}

/* Content Sections */
.content-section {
display: none;
animation: fadeIn 0.5s ease;
}

.content-section.active {
display: block;
}

@keyframes fadeIn {
from { opacity: 0; transform: translateY(20px); }
to { opacity: 1; transform: translateY(0); }
}

.section-header {
display: flex;
justify-content: space-between;
align-items: center;
margin-bottom: 2rem;
flex-wrap: wrap;
gap: 1rem;
}

.section-title {
font-family: 'Poppins', sans-serif;
font-size: 1.8rem;
font-weight: 600;
color: var(--text-light);
position: relative;
padding-bottom: 10px;
}

.section-title::after {
content: '';
position: absolute;
bottom: 0;
left: 0;
width: 60px;
height: 3px;
background: var(--primary-gold);
border-radius: 2px;
}

/* Daily Plans */
.plans-controls {
display: flex;
gap: 1rem;
margin-bottom: 2rem;
flex-wrap: wrap;
}

.search-box {
flex: 1;
min-width: 300px;
position: relative;
}

.search-box input,
.search-box select {
width: 100%;
padding: 0.9rem 1rem 0.9rem 3rem;
border: 1px solid rgba(212, 175, 55, 0.3);
border-radius: var(--border-radius);
background: var(--card-bg);
color: var(--text-light);
font-size: 1rem;
transition: var(--transition);
}

.search-box input:focus,
.search-box select:focus {
outline: none;
border-color: var(--primary-gold);
box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
}

.search-box i {
position: absolute;
left: 1rem;
top: 50%;
transform: translateY(-50%);
color: var(--primary-gold);
}

.view-filters {
display: flex;
gap: 0.5rem;
flex-wrap: wrap;
}

.view-filter {
padding: 0.6rem 1.2rem;
border: 1px solid rgba(212, 175, 55, 0.3);
background: var(--card-bg);
border-radius: 20px;
color: var(--text-gray);
cursor: pointer;
transition: var(--transition);
font-size: 0.9rem;
font-weight: 500;
}

.view-filter:hover {
border-color: var(--primary-gold);
color: var(--primary-gold);
}

.view-filter.active {
background: var(--primary-gold);
color: var(--dark-bg);
border-color: var(--primary-gold);
}

.daily-plans-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
gap: 1.5rem;
margin-bottom: 3rem;
}

@media (max-width: 768px) {
.daily-plans-grid {
grid-template-columns: 1fr;
}
}

.plan-card {
background: var(--card-bg);
border-radius: var(--border-radius);
overflow: hidden;
box-shadow: var(--shadow);
transition: var(--transition);
border: 1px solid rgba(212, 175, 55, 0.2);
position: relative;
}

.plan-card:hover {
box-shadow: var(--shadow-lg);
border-color: rgba(212, 175, 55, 0.4);
transform: translateY(-5px);
}

.plan-card.holiday {
border-left: 4px solid var(--warning);
}

.plan-header {
padding: 1.5rem;
border-bottom: 1px solid rgba(212, 175, 55, 0.2);
background: linear-gradient(135deg, rgba(212, 175, 55, 0.1), transparent);
display: flex;
justify-content: space-between;
align-items: center;
}

.plan-date {
font-family: 'Poppins', sans-serif;
font-weight: 600;
font-size: 1.2rem;
}

.plan-day {
color: var(--primary-gold);
font-size: 0.9rem;
margin-top: 0.25rem;
display: flex;
align-items: center;
gap: 5px;
}

.plan-status {
display: flex;
align-items: center;
gap: 10px;
}

.holiday-badge {
background: var(--warning);
color: var(--dark-bg);
padding: 0.4rem 1rem;
border-radius: 20px;
font-size: 0.8rem;
font-weight: 600;
display: flex;
align-items: center;
gap: 5px;
}

.completion-check {
display: flex;
align-items: center;
gap: 8px;
}

.completion-check input {
width: 20px;
height: 20px;
cursor: pointer;
accent-color: var(--primary-gold);
}

.completion-check label {
font-size: 0.85rem;
color: var(--text-gray);
cursor: pointer;
}

.plan-content {
padding: 1.5rem;
}

.subject-card {
background: rgba(255, 255, 255, 0.05);
border-radius: var(--border-radius);
padding: 1.25rem;
margin-bottom: 1rem;
border-left: 3px solid;
transition: var(--transition);
}

.subject-card:hover {
background: rgba(212, 175, 55, 0.05);
}

.subject-card:last-child {
margin-bottom: 0;
}

.subject-header {
display: flex;
justify-content: space-between;
align-items: center;
margin-bottom: 0.75rem;
}

.subject-title {
font-weight: 600;
font-size: 1.1rem;
display: flex;
align-items: center;
gap: 10px;
}

.subject-time {
background: rgba(212, 175, 55, 0.1);
padding: 0.4rem 0.8rem;
border-radius: 20px;
font-size: 0.85rem;
font-weight: 600;
color: var(--primary-gold);
display: flex;
align-items: center;
gap: 5px;
}

.topic-guide {
margin-top: 1rem;
padding: 1rem;
background: var(--darker-bg);
border-radius: 8px;
border-left: 3px solid var(--primary-gold);
}

.topic-guide h4 {
color: var(--primary-gold);
margin-bottom: 0.5rem;
font-size: 1rem;
}

.topic-guide p {
font-size: 0.9rem;
color: var(--text-light);
line-height: 1.6;
}

.study-time {
display: inline-block;
margin-top: 0.8rem;
font-size: 0.85rem;
color: var(--text-gray);
font-weight: 500;
background: rgba(212, 175, 55, 0.1);
padding: 0.3rem 0.8rem;
border-radius: 15px;
}

.plan-actions {
margin-top: 1.5rem;
padding-top: 1rem;
border-top: 1px solid rgba(212, 175, 55, 0.2);
display: flex;
justify-content: space-between;
align-items: center;
}

.notes-section {
margin-top: 1.5rem;
}

.notes-textarea {
width: 100%;
padding: 0.9rem;
border: 1px solid rgba(212, 175, 55, 0.3);
border-radius: var(--border-radius);
background: var(--card-bg);
color: var(--text-light);
font-size: 0.9rem;
resize: vertical;
min-height: 100px;
transition: var(--transition);
}

.notes-textarea:focus {
outline: none;
border-color: var(--primary-gold);
box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
}

/* Weekly Timetable */
.week-controls {
display: flex;
gap: 1rem;
margin-bottom: 2rem;
align-items: center;
flex-wrap: wrap;
}

.date-picker {
display: flex;
gap: 1rem;
align-items: center;
flex-wrap: wrap;
}

.date-picker input {
padding: 0.9rem;
border: 1px solid rgba(212, 175, 55, 0.3);
border-radius: var(--border-radius);
background: var(--card-bg);
color: var(--text-light);
font-size: 1rem;
min-width: 200px;
}

.timetable-container {
background: var(--card-bg);
border-radius: var(--border-radius);
padding: 2rem;
box-shadow: var(--shadow);
margin-bottom: 3rem;
overflow-x: auto;
}

.timetable {
width: 100%;
min-width: 1000px;
border-collapse: collapse;
}

.timetable th {
background: linear-gradient(135deg, var(--primary-gold), var(--dark-gold));
color: var(--dark-bg);
padding: 1.2rem;
text-align: left;
font-weight: 600;
font-size: 1rem;
border-bottom: 3px solid var(--dark-gold);
}

.timetable td {
padding: 1.2rem;
border: 1px solid rgba(212, 175, 55, 0.2);
vertical-align: top;
background: var(--card-bg);
}

.timetable tr:nth-child(even) td {
background: rgba(255, 255, 255, 0.03);
}

.timetable-day {
font-weight: 600;
color: var(--primary-gold);
margin-bottom: 0.5rem;
display: block;
font-size: 1.1rem;
}

.timetable-holiday {
text-align: center;
color: var(--warning);
font-weight: 600;
font-style: italic;
padding: 2rem;
}

.timetable-subject {
margin-bottom: 1rem;
padding-bottom: 1rem;
border-bottom: 1px dashed rgba(212, 175, 55, 0.3);
}

.timetable-subject:last-child {
margin-bottom: 0;
padding-bottom: 0;
border-bottom: none;
}

.timetable-topic {
font-size: 0.9rem;
color: var(--text-light);
margin: 0.5rem 0;
line-height: 1.5;
}

/* Roadmap Ladder */
.roadmap-container {
background: var(--card-bg);
border-radius: var(--border-radius);
padding: 3rem;
box-shadow: var(--shadow);
margin-bottom: 3rem;
position: relative;
}

.roadmap-ladder {
position: relative;
padding-left: 60px;
}

.roadmap-ladder::before {
content: '';
position: absolute;
left: 25px;
top: 0;
bottom: 0;
width: 3px;
background: linear-gradient(to bottom, var(--primary-gold), var(--dark-gold));
border-radius: 3px;
}

.roadmap-item {
position: relative;
margin-bottom: 3rem;
min-height: 180px;
}

.roadmap-item:last-child {
margin-bottom: 0;
}

.roadmap-item::before {
content: '';
position: absolute;
left: -40px;
top: 20px;
width: 16px;
height: 16px;
border-radius: 50%;
background: var(--text-gray);
border: 4px solid var(--card-bg);
z-index: 2;
box-shadow: 0 0 0 3px var(--primary-gold);
}

.roadmap-item.completed::before {
background: var(--success);
}

.roadmap-item.in-progress::before {
background: var(--warning);
animation: pulse 2s infinite;
}

.roadmap-item.upcoming::before {
background: var(--text-gray);
}

@keyframes pulse {
0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.7); }
70% { box-shadow: 0 0 0 10px rgba(245, 158, 11, 0); }
100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
}

.semester-badge {
position: absolute;
left: -85px;
top: 10px;
background: var(--primary-gold);
color: var(--dark-bg);
padding: 0.6rem 1.2rem;
border-radius: 20px;
font-weight: 700;
font-size: 1rem;
min-width: 100px;
text-align: center;
box-shadow: var(--shadow);
}

.roadmap-content {
background: rgba(255, 255, 255, 0.05);
border-radius: var(--border-radius);
padding: 2rem;
border: 1px solid rgba(212, 175, 55, 0.2);
transition: var(--transition);
}

.roadmap-content:hover {
transform: translateX(10px);
border-color: rgba(212, 175, 55, 0.4);
box-shadow: var(--shadow);
}

.semester-title {
font-family: 'Poppins', sans-serif;
font-size: 1.4rem;
font-weight: 600;
margin-bottom: 1.5rem;
color: var(--primary-gold);
display: flex;
align-items: center;
gap: 12px;
}

.semester-subjects {
display: flex;
flex-wrap: wrap;
gap: 0.8rem;
margin-bottom: 1.5rem;
}

.subject-tag {
background: rgba(212, 175, 55, 0.1);
color: var(--primary-gold);
padding: 0.5rem 1rem;
border-radius: 20px;
font-size: 0.9rem;
font-weight: 500;
border: 1px solid rgba(212, 175, 55, 0.3);
}

.skills-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
gap: 1rem;
margin-bottom: 1.5rem;
}

.skill-item {
background: var(--darker-bg);
padding: 1rem;
border-radius: 8px;
border-left: 3px solid var(--success);
font-size: 0.9rem;
transition: var(--transition);
}

.skill-item:hover {
transform: translateY(-3px);
box-shadow: var(--shadow);
}

.projects-list {
margin-top: 1.5rem;
padding-top: 1.5rem;
border-top: 1px solid rgba(212, 175, 55, 0.2);
}

.project-item {
display: flex;
align-items: center;
gap: 12px;
margin-bottom: 1rem;
padding: 0.8rem;
background: rgba(212, 175, 55, 0.05);
border-radius: 8px;
font-size: 0.9rem;
transition: var(--transition);
}

.project-item:hover {
background: rgba(212, 175, 55, 0.1);
transform: translateX(5px);
}

.project-item i {
color: var(--primary-gold);
font-size: 1.2rem;
}

/* Certificate Generator */
.certificate-form {
background: var(--card-bg);
border-radius: var(--border-radius);
padding: 2rem;
box-shadow: var(--shadow);
margin-bottom: 2rem;
}

.form-grid {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
gap: 1.5rem;
margin-bottom: 2rem;
}

.form-group {
display: flex;
flex-direction: column;
gap: 0.5rem;
}

.form-group label {
font-weight: 500;
color: var(--text-gray);
font-size: 0.9rem;
}

.form-group input,
.form-group select {
padding: 0.9rem;
border: 1px solid rgba(212, 175, 55, 0.3);
border-radius: var(--border-radius);
background: var(--darker-bg);
color: var(--text-light);
font-size: 1rem;
transition: var(--transition);
}

.form-group input:focus,
.form-group select:focus {
outline: none;
border-color: var(--primary-gold);
box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
}

.certificate-preview {
background: white;
border-radius: var(--border-radius);
padding: 3rem;
margin-bottom: 2rem;
box-shadow: var(--shadow);
position: relative;
border: 2px solid var(--primary-gold);
}

.certificate-border {
position: absolute;
top: 20px;
left: 20px;
right: 20px;
bottom: 20px;
border: 3px solid var(--primary-gold);
pointer-events: none;
}

.certificate-header {
text-align: center;
margin-bottom: 2rem;
position: relative;
}

.certificate-logo {
font-size: 3rem;
color: var(--primary-gold);
margin-bottom: 1rem;
}

.certificate-title {
font-family: 'Playfair Display', serif;
font-size: 2.5rem;
color: #1a1a2e;
margin-bottom: 0.5rem;
font-weight: 600;
}

.certificate-subtitle {
font-size: 1.2rem;
color: #666;
margin-bottom: 3rem;
}

.certificate-body {
text-align: center;
margin-bottom: 3rem;
}

.certificate-text {
font-size: 1.2rem;
color: #333;
line-height: 1.8;
margin-bottom: 2rem;
}

.certificate-details {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
gap: 1.5rem;
margin-bottom: 3rem;
}

.detail-item {
text-align: center;
}

.detail-label {
font-size: 0.9rem;
color: #666;
margin-bottom: 0.5rem;
}

.detail-value {
font-size: 1.1rem;
font-weight: 600;
color: #1a1a2e;
padding: 0.8rem;
background: #f8f9fa;
border-radius: 8px;
border: 1px solid #dee2e6;
}

.certificate-footer {
display: flex;
justify-content: space-between;
align-items: flex-end;
margin-top: 3rem;
}

.signature-box {
text-align: center;
}

.signature-line {
width: 200px;
height: 1px;
background: #333;
margin: 2rem auto 0.5rem;
}

.signature-text {
font-size: 1rem;
color: #333;
}

/* Print Styles */
@media print {
body {
background: white !important;
color: black !important;
padding-top: 0 !important;
