function formatDate(date) {
return date.toLocaleDateString('en-US', {
day: 'numeric',
month: 'long',
weekday: 'long',
year: 'numeric'
});
}

function formatDateShort(date) {
return date.toLocaleDateString('en-US', {
day: 'numeric',
month: 'short'
});
}

function formatDateForInput(date) {
return date.toISOString().split('T')[0];
}

function getDayName(date) {
return date.toLocaleDateString('en-US', { weekday: 'long' });
}

function generateDailyPlan(date) {
const dayName = getDayName(date);
const isSunday = dayName === 'Sunday';

if (isSunday) {
return {
date: new Date(date),
formattedDate: formatDate(date),
shortDate: formatDateShort(date),
dayName: dayName,
isHoliday: true,
subjects: []
};
}

const subjectList = Object.keys(subjects);
const dayIndex = Math.floor((date - new Date('2025-01-10')) / (1000 * 60 * 60 * 24));
const subjectIndex1 = dayIndex % subjectList.length;
const subjectIndex2 = (dayIndex + 2) % subjectList.length;

const selectedSubjects = [
subjectList[subjectIndex1],
subjectList[subjectIndex2]
];

const planSubjects = selectedSubjects.map((subject, index) => {
const subjectData = subjects[subject];
const topicIndex = Math.floor(dayIndex / 5) % subjectData.topics.length;

return {
name: subject,
color: subjectData.color,
icon: subjectData.icon,
time: timeSlots[index % timeSlots.length],
topic: subjectData.topics[topicIndex]
};
});

return {
date: new Date(date),
formattedDate: formatDate(date),
shortDate: formatDateShort(date),
dayName: dayName,
isHoliday: false,
subjects: planSubjects
};
}

function generateAllPlans() {
const plans = [];
const currentDate = new Date('2025-01-10');
const endDate = new Date('2025-03-10');

while (currentDate <= endDate) {
plans.push(generateDailyPlan(new Date(currentDate)));
currentDate.setDate(currentDate.getDate() + 1);
}

return plans;
}

function calculateStats() {
const totalDays = 60;
const holidayDays = 8; // Approximate Sundays
const studyDays = totalDays - holidayDays;

const completedStudyDays = Object.values(appState.completedDays).filter(Boolean).length;
const completionRate = Math.round((completedStudyDays / studyDays) * 100);

const totalTopics = 5 * 4 * 5; // 5 subjects * 4 topics each * 5 weeks
const completedTopics = Object.values(appState.completedTopics).flat().length;
const topicProgress = Math.round((completedTopics / totalTopics) * 100);

// Update streak
// Update streak
const today = new Date();
today.setHours(0, 0, 0, 0); // FIXED: parentheses and 4 arguments (ms included)

const yesterday = new Date(today);
yesterday.setDate(yesterday.getDate() - 1);

const todayStr = formatDateForInput(today);
const yesterdayStr = formatDateForInput(yesterday);

if (appState.completedDays[todayStr]) {
  if (appState.lastStudyDate === yesterdayStr) {
    appState.currentStreak++;
  } else if (appState.lastStudyDate !== todayStr) {
    appState.currentStreak = 1;
  }
  appState.lastStudyDate = todayStr;
}

if (appState.currentStreak > appState.bestStreak) {
  appState.bestStreak = appState.currentStreak;
}

// Calculate weekly hours
const lastWeek = new Date(today);
lastWeek.setDate(lastWeek.getDate() - 7);
let weeklyHours = 0;

for (const [date, completed] of Object.entries(appState.completedDays)) {
if (completed && new Date(date) >= lastWeek) {
weeklyHours += 3; // Approximate 3 hours per study day
}
}

return {
completedDays: completedStudyDays,
totalDays: studyDays,
completionRate,
currentStreak: appState.currentStreak,
bestStreak: appState.bestStreak,
topicProgress,
completedTopics,
totalTopics,
weeklyHours
};
}

